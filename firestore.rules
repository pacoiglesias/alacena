rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE AUTENTICACION Y ROLES (RBAC)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtener datos del usuario desde la coleccion /users
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Rol Admin: Acceso total a precios, alertas, catalogos y eliminaciones
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    // Rol Servicio: Rol operativo ultra simplificado
    function isService() {
      return isAuthenticated() && (
        request.auth.token.role == 'service' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'service')
      );
    }

    // Verificar si el usuario pertenece a un hogar especifico
    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
      );
    }

    // =========================================================================
    // COLECCION: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      // Cada usuario puede leer su propio perfil; el Admin puede leer todos
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Solo el Admin puede asignar o cambiar roles
      allow create, update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuperAdmin']))
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // COLECCION: /households/{householdId} (Multi-hogar)
    // =========================================================================
    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create, update, delete: if isAdmin();

      // Miembros del hogar (RBAC por hogar)
      match /members/{memberId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isAdmin();
      }

      // Zonas del hogar (Alacena 1, Cava Subterranea, Cuarto Frio, etc.)
      match /zones/{zoneId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isAdmin();
      }

      // =======================================================================
      // SUBCOLECCION: /items/{itemId} (Inventario de Alacena, Cava, Insumos)
      // =======================================================================
      match /items/{itemId} {
        // Lectura permitida a miembros del hogar
        allow read: if isHouseholdMember(householdId);

        // Creacion de articulos: Exclusivo de Administradores
        allow create: if isAdmin() && 
          request.resource.data.householdId == householdId;

        // Actualizacion:
        // - Admin: Libre
        // - Servicio: SOLO PUEDE actualizar stock/consumo y timestamps.
        //   PROHIBIDO alterar precios, nombres, codigos QR o flags de seguridad.
        allow update: if isHouseholdMember(householdId) && (
          isAdmin() || (
            isService() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'currentQuantity',
              'stockStatus',
              'lastScannedAt',
              'lastScannedBy',
              'updatedAt'
            ]) &&
            // Integridad de tipos y valores numericos no negativos
            request.resource.data.currentQuantity is number &&
            request.resource.data.currentQuantity >= 0 &&
            request.resource.data.stockStatus in ['OPTIMAL', 'LOW', 'OUT_OF_STOCK']
          )
        );

        // ELIMINACION: MATEMATICAMENTE IMPOSIBLE PARA ROL SERVICIO
        // Solo administradores pueden borrar del inventario
        allow delete: if isAdmin();
      }

      // =======================================================================
      // SUBCOLECCION: /audit_trail/{logId} (TRAZABILIDAD TOTAL ANTI-ROBOS)
      // =======================================================================
      match /audit_trail/{logId} {
        // Lectura: Exclusiva de Administradores (Oculto para rol Servicio)
        allow read: if isAdmin();

        // Escritura (Append-Only): 
        // Cualquier miembro que opere puede registrar la accion inalterable.
        // Debe sellar con UID real y timestamp del servidor.
        allow create: if isHouseholdMember(householdId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.timestamp == request.time &&
          request.resource.data.householdId == householdId &&
          request.resource.data.action in ['SCAN_CONSUME', 'SCAN_RESTOCK', 'MANUAL_ADJUST', 'CREATE_ITEM', 'DELETE_ITEM', 'MOVE_ZONE'];

        // REGLA CRITICA: PROHIBIDO EDITAR O BORRAR LOGS HISTORICOS (INALTERABLE)
        allow update, delete: if false;
      }

      // =======================================================================
      // SUBCOLECCION: /shopping_list/{listId} (Lista de Compras Inteligente)
      // =======================================================================
      match /shopping_list/{listId} {
        allow read: if isHouseholdMember(householdId);

        // Tanto Admin como Servicio pueden anadir articulos a comprar
        allow create: if isHouseholdMember(householdId) &&
          request.resource.data.householdId == householdId;

        // Actualizacion: Marcar como comprado o ajustar cantidad a comprar
        allow update: if isHouseholdMember(householdId);

        // Eliminacion: Admin o el usuario que lo marco completado
        allow delete: if isAdmin() || (
          isHouseholdMember(householdId) && resource.data.isPurchased == true
        );
      }
    }

    // =========================================================================
    // COLECCION: /system_alerts/{alertId} (Notificaciones Push y Alertas Críticas)
    // =========================================================================
    match /system_alerts/{alertId} {
      allow read: if isAdmin();
      // Generadas por Cloud Functions o por la app ante eventos criticos
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
