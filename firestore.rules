rules_version = '2';
// =============================================================================
// 🛡️ ALACENA Enterprise & CavaPro — Firestore Security Rules
// Versión: v3.3.0-Titanium-Aurora-Perfection
// Proyecto: alacena-enterprise-prod
// Estatus: PRODUCCIÓN (Audit Trail Append-Only + Multi-Tenant RBAC + Web & Mobile)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 🏛️ FUNCIONES AUXILIARES: MULTI-TENANT SaaS & CONTROL RBAC
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Acceso a la casa autorizado exclusivamente mediante Admin SDK (custom claim).
    // No basta con iniciar sesión, ni con elegir un rol en la interfaz.
    function hasHomeAccess() {
      return isAuthenticated() && request.auth.token.email_verified == true &&
        request.auth.token.alacenaAccess == true;
    }

    function validHomeRecord() {
      return request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 300 &&
        request.resource.data.quantity is number && request.resource.data.quantity >= 0 &&
        request.resource.data.quantity <= 1000000 &&
        request.resource.data.householdId is string &&
        request.resource.data.householdId.size() <= 128;
    }

    // Obtener datos del miembro dentro del workspace/tenant
    function getWorkspaceMember(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
    }

    // Verificar si el usuario pertenece al Workspace
    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && (
        request.auth.token.workspaceId == workspaceId ||
        request.auth.token.tenantId == workspaceId ||
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
      );
    }

    // Rol Admin / Owner del Workspace (Control total: precios, auditoría, configuración)
    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId) && (
        ((request.auth.token.workspaceId == workspaceId || request.auth.token.tenantId == workspaceId) && request.auth.token.role in ['admin', 'owner', 'superadmin']) ||
        getWorkspaceMember(workspaceId).role in ['admin', 'owner']
      );
    }

    // Rol Servicio del Workspace (Operación rápida: consumir, reabastecer; CERO acceso financiero)
    function isWorkspaceService(workspaceId) {
      return isWorkspaceMember(workspaceId) && (
        request.auth.token.role == 'service' ||
        getWorkspaceMember(workspaceId).role == 'service'
      );
    }

    // =========================================================================
    // 👤 PERFILES DE USUARIO: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role == 'superadmin');
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['role', 'isAdmin', 'workspaceId', 'tenantId', 'alacenaAccess']);
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'workspaceId', 'tenantId', 'alacenaAccess']);
      allow delete: if false;
    }

    // =========================================================================
    // 🌐 CATÁLOGO MAESTRO COMPARTIDO: /global_ean_cache/{barcode}
    // =========================================================================
    match /global_ean_cache/{barcode} {
      allow read: if true; // Lectura pública para escaneo rápido de códigos
      allow create: if isAuthenticated() &&
        request.resource.data.barcode == barcode &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    // =========================================================================
    // 🏠 COLECCIONES GLOBALES / WEB DIRECTAS:
    // Soporte para clientes web y sincronización directa
    // =========================================================================

    match /products/{productId} {
      allow read, delete: if hasHomeAccess();
      allow create, update: if hasHomeAccess() && validHomeRecord();
    }
    match /shopping_list/{itemId} {
      allow read, delete: if hasHomeAccess();
      allow create, update: if hasHomeAccess() && validHomeRecord() &&
        request.resource.data.quantity > 0 && request.resource.data.checked is bool;
    }
    match /zones/{zoneId} { allow read, write: if hasHomeAccess(); }
    match /recipes/{recipeId} { allow read, write: if hasHomeAccess(); }
    match /households/{houseId} { allow read, write: if hasHomeAccess(); }
    match /learned_products/{productId} { allow read, write: if hasHomeAccess(); }
    match /purchase_history/{receiptId} {
      allow read: if hasHomeAccess();
      allow create: if hasHomeAccess() && request.resource.data.items is list && request.resource.data.items.size() <= 150 && request.resource.data.totalMxn is number && request.resource.data.totalMxn >= 0;
      allow update: if hasHomeAccess() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items']) && request.resource.data.items is list && request.resource.data.items.size() <= 150;
      allow delete: if false;
    }
    match /audit_logs/{logId} {
      allow read: if hasHomeAccess();
      allow create: if hasHomeAccess() && request.resource.data.cloudTimestamp == request.time &&
        request.resource.data.description is string && request.resource.data.description.size() <= 4000;
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId);
      allow create: if isAuthenticated(); // Alta de nueva cuenta/familia SaaS
      allow update, delete: if isWorkspaceAdmin(workspaceId);

      // --- Miembros y Asignación de Roles del Workspace ---
      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow write: if isWorkspaceAdmin(workspaceId);
      }

      // --- Residencias / Hogares del Workspace ---
      match /households/{householdId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update, delete: if isWorkspaceAdmin(workspaceId);

        // Zonas físicas (Alacena, Cava, Refrigerador, Barra)
        match /zones/{zoneId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow write: if isWorkspaceAdmin(workspaceId);
        }

        // =====================================================================
        // 📦 INVENTARIO BASE: /items/{itemId}
        // =====================================================================
        match /items/{itemId} {
          allow read: if isWorkspaceMember(workspaceId);

          allow create: if isWorkspaceAdmin(workspaceId) &&
            request.resource.data.workspaceId == workspaceId &&
            request.resource.data.householdId == householdId;

          allow update: if isWorkspaceMember(workspaceId) && (
            isWorkspaceAdmin(workspaceId) || (
              isWorkspaceService(workspaceId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'currentQuantity',
                'stockStatus',
                'lastScannedAt',
                'lastScannedBy',
                'updatedAt'
              ]) &&
              request.resource.data.currentQuantity is number &&
              request.resource.data.currentQuantity >= 0
            )
          );

          allow delete: if isWorkspaceAdmin(workspaceId);

          match /private_financial/{docId} {
            allow read, write: if isWorkspaceAdmin(workspaceId);
          }
        }

        // =====================================================================
        // 🏛️ AUDIT TRAIL INALTERABLE: /audit_trail/{auditId}
        // =====================================================================
        match /audit_trail/{auditId} {
          allow read: if isWorkspaceAdmin(workspaceId);
          allow create: if isWorkspaceMember(workspaceId) &&
            request.resource.data.workspaceId == workspaceId &&
            request.resource.data.householdId == householdId &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.timestamp == request.time;
          // CRÍTICO: PROHIBIDO EDITAR O BORRAR LOGS HISTÓRICOS
          allow update, delete: if false;
        }

        // Ajustes y Mermas
        match /inventory_adjustments/{adjustmentId} {
          allow read: if isWorkspaceAdmin(workspaceId);
          allow create: if isWorkspaceAdmin(workspaceId);
          allow update, delete: if false;
        }

        // Conteos Cíclicos
        match /cycle_counts/{sessionId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create, update: if isWorkspaceAdmin(workspaceId);
          allow delete: if false;
        }

        // Live Shopping
        match /shopping_list/{listItemId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow create: if isWorkspaceMember(workspaceId);
          allow update: if isWorkspaceMember(workspaceId);
          allow delete: if isWorkspaceAdmin(workspaceId) || (
            isWorkspaceMember(workspaceId) && resource.data.isPurchased == true
          );
        }

        // Sommelier Cava
        match /cellar_profiles/{wineId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow write: if isWorkspaceAdmin(workspaceId);
        }

        // Recetas Zero-Waste
        match /zero_waste_recipes/{recipeId} {
          allow read: if isWorkspaceMember(workspaceId);
          allow write: if isWorkspaceAdmin(workspaceId);
        }
      }
    }

    // Soporte retrocompatible para ruta alternativa /tenants/{tenantId}
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if isAuthenticated() && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.workspaceId == tenantId ||
        request.auth.token.tenantId == tenantId
      );
    }
  }
}
