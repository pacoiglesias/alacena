rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 🏛️ FUNCIONES AUXILIARES: MULTI-TENANT SaaS & RBAC
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtener membresía del usuario dentro del tenant
    function getTenantMember(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data;
    }

    // Verificar si el usuario pertenece al tenant (Workspace/Familia)
    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId ||
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
      );
    }

    // Rol Admin / Owner dentro del Tenant (acceso a precios, auditoria, catalogo)
    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId) && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        getTenantMember(tenantId).role in ['admin', 'owner']
      );
    }

    // Rol Servicio dentro del Tenant (consumo rapido y compras; sin precios ni logs)
    function isTenantService(tenantId) {
      return isTenantMember(tenantId) && (
        request.auth.token.role == 'service' ||
        getTenantMember(tenantId).role == 'service'
      );
    }

    // =========================================================================
    // 👤 COLECCIÓN GLOBAL: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role == 'superadmin');
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // =========================================================================
    // 🌐 CATÁLOGO GLOBAL DE PRODUCTOS EAN-13 / UPC (Caché OpenFoodFacts)
    // =========================================================================
    match /global_products_catalog/{barcode} {
      // Lectura pública/compartida para autocompletar productos de supermercado
      allow read: if isAuthenticated();
      // Cualquier usuario autenticado puede aportar un nuevo producto escaneado si es valido
      allow create: if isAuthenticated() &&
        request.resource.data.barcode == barcode &&
        request.resource.data.name is string &&
        request.resource.data.createdAt == request.time;
      // Solo Cloud Functions o Admins pueden editar el catalogo global
      allow update, delete: if isAuthenticated() && request.auth.token.role == 'superadmin';
    }

    // =========================================================================
    // 🏢 ARQUITECTURA MULTI-TENANT: /tenants/{tenantId}
    // =========================================================================
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow create: if isAuthenticated(); // Alta de nueva cuenta SaaS
      allow update, delete: if isTenantAdmin(tenantId);

      // --- Miembros y Permisos del Tenant ---
      match /members/{memberId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // --- Hogares / Residencias dentro del Tenant ---
      match /households/{householdId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);

        // Zonas del hogar (Alacena, Cava, Refrigerador, Bar)
        match /zones/{zoneId} {
          allow read: if isTenantMember(tenantId);
          allow write: if isTenantAdmin(tenantId);
        }

        // =====================================================================
        // 📦 SUBCOLECCIÓN: /items/{itemId} (Inventario, Precios & EAN)
        // =====================================================================
        match /items/{itemId} {
          allow read: if isTenantMember(tenantId);

          // Creación de artículos: Exclusivo de Admin
          allow create: if isTenantAdmin(tenantId) &&
            request.resource.data.tenantId == tenantId &&
            request.resource.data.householdId == householdId;

          // Actualización:
          // - Admin: Acceso total (modificar precios, historial, lugares de compra)
          // - Servicio: SOLO PUEDE modificar stock, estado y última fecha de escaneo.
          //   BLOQUEO MATEMÁTICO: No puede alterar precio, historial ni metadatos financieros.
          allow update: if isTenantMember(tenantId) && (
            isTenantAdmin(tenantId) || (
              isTenantService(tenantId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'currentQuantity',
                'stockStatus',
                'lastScannedAt',
                'lastScannedBy',
                'updatedAt'
              ]) &&
              request.resource.data.currentQuantity is number &&
              request.resource.data.currentQuantity >= 0 &&
              request.resource.data.stockStatus in ['OPTIMAL', 'LOW', 'OUT_OF_STOCK']
            )
          );

          // ELIMINACIÓN: MATEMÁTICAMENTE IMPOSIBLE PARA ROL SERVICIO
          allow delete: if isTenantAdmin(tenantId);
        }

        // =====================================================================
        // 🔒 SUBCOLECCIÓN: /audit_trail/{auditId} (Trazabilidad Financiera)
        // =====================================================================
        match /audit_trail/{auditId} {
          // Lectura: Exclusiva de Administradores (Oculto para personal de servicio)
          allow read: if isTenantAdmin(tenantId);

          // Escritura (Append-Only): Sello criptográfico con UID, servidor y valor económico
          allow create: if isTenantMember(tenantId) &&
            request.resource.data.tenantId == tenantId &&
            request.resource.data.householdId == householdId &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.timestamp == request.time &&
            request.resource.data.action in [
              'SCAN_CONSUME', 'SCAN_RESTOCK', 'MANUAL_ADJUST',
              'CREATE_ITEM', 'DELETE_ITEM', 'MOVE_ZONE', 'SHOPPING_RESTOCK', 'AUTO_SEED'
            ];

          // CRÍTICO: PROHIBIDO EDITAR O BORRAR LOGS HISTÓRICOS
          allow update, delete: if false;
        }

        // =====================================================================
        // 🛒 SUBCOLECCIÓN: /shopping_list/{listItemId} (Agente de Compras & Web)
        // =====================================================================
        match /shopping_list/{listItemId} {
          allow read: if isTenantMember(tenantId);
          allow create: if isTenantMember(tenantId) &&
            request.resource.data.tenantId == tenantId;
          allow update: if isTenantMember(tenantId);
          allow delete: if isTenantAdmin(tenantId) || (
            isTenantMember(tenantId) && resource.data.isPurchased == true
          );
        }

        // =====================================================================
        // 🍳 SUBCOLECCIÓN: /zero_waste_recipes/{recipeId} (Chef IA Zero-Waste)
        // =====================================================================
        match /zero_waste_recipes/{recipeId} {
          allow read: if isTenantMember(tenantId);
          allow write: if isTenantAdmin(tenantId);
        }
      }
    }
  }
}
